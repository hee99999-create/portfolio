# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
OPENAI_API_KEY=sk-...

# 사용할 모델 (기본: gpt-4o. 비용 절감 시 gpt-4o-mini)
CDA_MODEL=gpt-4o

# CORS 허용 오리진 (프론트 주소). 여러 개면 콤마로 구분
CDA_ALLOWED_ORIGINS=http://localhost:8125,https://hee99999-create.github.io

# --- 공개 배포 시 비용 방어 (Render 등 외부에 올릴 때 반드시 확인) ---
# IP당 시간당 최대 분석 요청 수. 0 이하로 두면 제한 없음(로컬 개발용 기본값과 다르니 주의).
CDA_RATE_LIMIT_PER_HOUR=20
# 한 번에 분석 요청할 수 있는 텍스트 최대 길이(글자 수). 너무 크게 두면 비용이 커질 수 있음.
CDA_MAX_TEXT_LEN=6000
